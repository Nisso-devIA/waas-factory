[Unit]
Description=WaaS FastAPI Checkout & Stripe Webhook Server
After=network.target

[Service]
Type=simple
User=waas
Group=waas
UMask=0022
WorkingDirectory=/opt/waas-factory
EnvironmentFile=/opt/waas-factory/.env
ExecStart=/opt/waas-factory/venv/bin/uvicorn webhook_server:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
